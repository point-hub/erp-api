@baseUrl = {{$dotenv BASE_URL}}

###
# @name createCounter
# @prompt name
# @prompt phone
POST {{baseUrl}}/v1/counters HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "name": "{{name}}",
  "phone": "{{phone}}"
}

###
# @name createManyCounter
# @prompt name1
# @prompt phone1
# @prompt name2
# @prompt phone2
POST {{baseUrl}}/v1/counters/create-many HTTP/1.1
Accept: application/json
Content-Type: application/json

[
  {
    "name": "{{name1}}",
    "phone": "{{phone1}}"  
  },
  {
    "name": "{{name2}}",
    "phone": "{{phone2}}"  
  }
]

###
# @name retrieveAllCounter
GET {{baseUrl}}/v1/counters?filter[name]=branch-code HTTP/1.1
Accept: application/json
Content-Type: application/json

###
# @name retrieveCounter
# @prompt id
GET {{baseUrl}}/v1/counters/{{id}} HTTP/1.1
Accept: application/json
Content-Type: application/json

###
# @name updateCounter
# @prompt id
# @prompt name
# @prompt phone
PATCH {{baseUrl}}/v1/counters/{{id}} HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "name": "{{name}}",
  "phone": "{{phone}}"
}

###
# @name updateManyCounter
# @prompt name
# @prompt phone
POST {{baseUrl}}/v1/counters/update-many HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "filter": {
    "name": "{{name}}"
  },
  "data": {
    "phone": "{{phone}}"
  }
}

###
# @name deleteCounter
# @prompt id
DELETE {{baseUrl}}/v1/counters/{{id}} HTTP/1.1
Accept: application/json
Content-Type: application/json

###
# @name deleteManyCounter
# @prompt id1
# @prompt id2
POST {{baseUrl}}/v1/counters/delete-many HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "ids": ["{{id1}}","{{id2}}"]
}

###
# @name createTransactionCounter
# @prompt name1
# @prompt phone1
# @prompt name2
# @prompt phone2
POST {{baseUrl}}/v1/counters/transaction HTTP/1.1
Accept: application/json
Content-Type: application/json

{
  "data1": {
    "name": "{{name1}}",
    "phone": "{{phone1}}"  
  },
  "data2": {
    "name": "{{name2}}",
    "phone": "{{phone2}}"  
  }
}